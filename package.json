{
  "name": "@jcs130/dsh-minecraft-agent",
  "version": "0.3.0-rc.9",
  "repository": { "type": "git", "url": "git+https://github.com/jcs130/dsh-minecraft-agent.git" },
  "homepage": "https://github.com/jcs130/dsh-minecraft-agent#readme",
  "bugs": { "url": "https://github.com/jcs130/dsh-minecraft-agent/issues" },
  "author": "jcs130",
  "icon": "assets/icon.svg",
  "type": "module",
  "description": "DeepSeek Harness host adapter for the independent Minecraft SDK, with shared visualization and optional server capability packs.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "main": "./lib/plugins/mc-harness.mjs",
  "bin": { "dsh-minecraft-assets": "./bin/prepare-assets.mjs" },
  "exports": {
    ".": "./lib/plugins/mc-harness.mjs",
    "./client": "./lib/client.js",
    "./harness2": "./lib/plugins/harness2.mjs",
    "./locale/*.json": "./locales/*.json",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-harness.mjs",
    "prepack": "node scripts/build-harness.mjs",
    "prepublishOnly": "node scripts/build-harness.mjs",
    "test": "node --test test/*.test.mjs",
    "dry-run": "node scripts/dry-run.mjs"
  },
  "files": [
    "lib/plugins/mc-harness.mjs",
    "lib/plugins/harness-bridge.mjs",
    "lib/plugins/harness-panel.mjs",
    "lib/plugins/harness-lifecycle.mjs",
    "lib/plugins/harness-goal.mjs",
    "lib/plugins/harness2.mjs",
    "lib/plugins/harness-budget.mjs",
    "lib/plugins/event-condenser-fallback.mjs",
    "lib/client.js",
    "bin/prepare-assets.mjs",
    "docs/harness-migration.md",
    "docs/harness2.md",
    "docs/desktop.md",
    "docs/registry-release.md",
    "docs/upstream",
    "assets/icon.svg",
    "locales",
    "examples/harness",
    "candidate-sources.json",
    "data/transmigrators",
    "README.md",
    "README.en.md",
    "README-INSTALL.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "agent-mc-world": "0.5.7-rc.57"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "agent-mc-qiandengji": "0.5.0-rc.3"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  }
}
