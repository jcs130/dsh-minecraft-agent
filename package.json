{
  "name": "@jcs130/dsh-minecraft-agent",
  "version": "0.3.0-rc.24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/dsh-minecraft-agent.git"
  },
  "homepage": "https://github.com/jcs130/dsh-minecraft-agent#readme",
  "bugs": {
    "url": "https://github.com/jcs130/dsh-minecraft-agent/issues"
  },
  "author": "jcs130",
  "icon": "assets/icon.svg",
  "type": "module",
  "description": "DeepSeek Harness host adapter for the independent Minecraft SDK, with shared visualization and optional server capability packs.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "main": "./lib/plugins/mc-harness.mjs",
  "bin": {
    "dsh-minecraft-assets": "./bin/prepare-assets.mjs",
    "dsh-minecraft-doctor": "./bin/repair-dsh.mjs",
    "dsh-minecraft-join": "./bin/join-qiandengji.mjs"
  },
  "exports": {
    ".": "./lib/plugins/mc-harness.mjs",
    "./client": "./lib/client.js",
    "./harness2": "./lib/plugins/harness2.mjs",
    "./locale/*.json": "./locales/*.json",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-harness.mjs",
    "prepack": "node scripts/build-harness.mjs",
    "prepublishOnly": "node scripts/build-harness.mjs",
    "test": "node --test test/*.test.mjs",
    "dry-run": "node scripts/dry-run.mjs"
  },
  "files": [
    "lib/plugins/mc-harness.mjs",
    "lib/plugins/harness-bridge.mjs",
    "lib/plugins/harness-panel.mjs",
    "lib/plugins/harness-lifecycle.mjs",
    "lib/plugins/harness-goal.mjs",
    "lib/plugins/harness-autonomy.mjs",
    "lib/plugins/harness2.mjs",
    "lib/plugins/harness-budget.mjs",
    "lib/plugins/event-condenser-fallback.mjs",
    "lib/client.js",
    "bin/prepare-assets.mjs",
    "docs/harness-migration.md",
    "docs/harness2.md",
    "docs/desktop.md",
    "docs/quick-start.md",
    "docs/goal-session-reset.md",
    "docs/continuous-autonomy.md",
    "docs/autonomy-viewer-20261028.md",
    "docs/survival-decision.md",
    "docs/minedojo-knowledge.md",
    "docs/authme-login.md",
    "docs/screenshots",
    "ui-verification-20261024.json",
    "authme-verification-20261024.json",
    "viewer-verification-20261025.json",
    "docs/viewer-fixes-20261025.md",
    "docs/character-notebook.md",
    "docs/viewer-resources-chat.md",
    "docs/registry-release.md",
    "docs/upstream",
    "assets/icon.svg",
    "locales",
    "examples/harness",
    "candidate-sources.json",
    "data/transmigrators",
    "README.md",
    "README.en.md",
    "README-INSTALL.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/core-update-20261021.md",
    "bin/repair-dsh.mjs",
    "lib/plugins/dsh-compat.mjs",
    "docs/DSH-COMPAT.md",
    "lib/plugins/dsh-native-streams.mjs",
    "lib/plugins/qiandengji-access.mjs",
    "lib/plugins/quick-setup.mjs",
    "lib/plugins/profile-settings.mjs",
    "lib/plugins/harness-composition.mjs",
    "bin/join-qiandengji.mjs",
    "docs/qiandengji-invitation.md",
    "profile-verification-20261025.json",
    "viewer-resources-verification-20261025.json",
    "goal-session-verification-20261025.json",
    "minedojo-verification-20261025.json",
    "docs/viewer-compatible-20261025.md",
    "docs/viewer-compatible-20261025.json",
    "docs/core-sync-verification-20261026.json",
    "docs/core-sync-rc99-verification-20261026.json",
    "docs/release-rc24.md",
    "docs/release-rc24-verification.json",
    "docs/core-viewer-sync-20261027.md",
    "docs/core-viewer-sync-20261027.json",
    "docs/autonomy-viewer-20261028.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "agent-mc-world": "0.5.7-rc.99",
    "readable-stream": "4.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "agent-mc-qiandengji": "0.5.0-rc.24"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  }
}
