{
  "name": "dsh-minecraft-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "A DeepSeek Harness plugin that lets an AI agent live and act autonomously in Minecraft — mineflayer service + MC tools, driven by a local Qwen3.8 model.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "main": "lib/bootstrap.mjs",
  "exports": {
    ".": {
      "default": "./lib/bootstrap.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./lib/*": "./lib/*",
    "./bin/*": "./bin/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-minecraft-agent": "./bin/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "README.md",
    "README.en.md",
    "README-INSTALL.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "prismarine-viewer": "^1.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-timer": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.62.1"
  }
}