{
  "name": "dsh-minecraft-agent",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness host adapter for the independent Minecraft SDK, with shared visualization and optional server capability packs.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "main": "./lib/plugins/mc-harness.mjs",
  "exports": {
    ".": "./lib/plugins/mc-harness.mjs",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-harness.mjs",
    "prepack": "node scripts/build-harness.mjs",
    "prepublishOnly": "node scripts/build-harness.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "lib/plugins/mc-harness.mjs",
    "lib/plugins/harness-bridge.mjs",
    "docs/harness-migration.md",
    "data/transmigrators",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "agent-mc-world": "0.4.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  },
  "optionalDependencies": {
    "agent-mc-qiandengji": "0.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
