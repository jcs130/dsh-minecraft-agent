{
  "name": "dsh-minecraft-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "A DeepSeek Harness plugin that lets an AI agent live and act autonomously in Minecraft — mineflayer service + MC tools, driven by a local Qwen3.8 model.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "main": "lib/bootstrap.mjs",
  "bin": {
    "dsh-minecraft-agent": "./bin/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "src/",
    "scripts/build.mjs",
    "bootstrap-mc.mts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README-INSTALL.md"
  ],
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "canvas": "^3.1.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "playwright-core": "^1.62.1",
    "prismarine-viewer": "^1.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-timer": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.25.0"
  }
}
