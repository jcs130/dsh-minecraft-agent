# @jcs130/dsh-minecraft-agent — 本机环境变量示例。复制为 .env（已被 .gitignore 忽略），不要提交真实值。
# 插件本身的服务器、账号、人设、模型等设置写在私有 Agent JSON（见 examples/harness/agent.json），
# 由 DSH profile 中 mc-harness.config.configFile 指向。

# DeepSeek 官方云端密钥，由 DSH 的 llm-deepseek provider 读取（apiKeyEnv: DEEPSEEK_API_KEY）。
DEEPSEEK_API_KEY=

# 以下仅供 `npm run dry-run -- --connect`（无模型试跑）和 docs/legacy/scripts 中的旧诊断脚本使用；
# 正式运行请在 Agent JSON 的 minecraft.host/port/username/version 中设置。
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21.1
MC_USERNAME=ExampleAgent
# 可选：服务器登录插件的私有账号配置（agent-mc-world 的 loginConfigFile），绝对路径或相对当前目录。
MC_LOGIN_CONFIG=

# 可选：指向外置 DSH 安装根目录供测试使用。
# DSH_RUNTIME=
